# Root Environment Template
# Copy this to server/.env and client/.env respectively

# Backend (.env in /server)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/network_monitor?retryWrites=true&w=majority
PING_TIMEOUT_MS=3000
DEFAULT_PING_TARGET=8.8.8.8
DEMO_MODE=false

# Frontend (.env in /client)
VITE_API_BASE_URL=http://localhost:5000/api
